# Copy to backend/.env locally. Never commit the real file or paste a key in chat.
# Mock mode is deterministic demonstration output, not an AI model.
PROVIDER_MODE=mock
OPENAI_API_KEY=
# Set an available Responses API model supporting strict structured outputs.
OPENAI_MODEL=gpt-4.1-mini
# Keep fixed throughout a demonstration; restarting does not reset its 50-call cap.
DEMO_SESSION_ID=part2-local
